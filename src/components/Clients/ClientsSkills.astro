---
import Picture from '../ui/Picture.astro';
import TextLink from '../ui/TextLink.astro';
import { clients, skills } from '../../data/site';
---

<section class="clients-skills" aria-labelledby="clients-heading" id="Skills">
  <div class="clients-skills__inner section-pad">
    <div class="clients-skills__grid">
      <div class="clients-skills__copy">
        <h2 id="clients-heading" class="clients-skills__heading">
          I've worked with companies like{' '}
          {
            clients.items.map((client, index) => (
              <>
                <button
                  type="button"
                  class:list={['clients-skills__name', `clients-skills__name--${client.id}`]}
                  data-client={client.id}
                  aria-describedby={`client-visual-${client.id}`}
                >
                  {client.name}
                </button>
                {index < clients.items.length - 2 && ', '}
                {index === clients.items.length - 2 && <>&nbsp;&amp; </>}
              </>
            ))
          }
        </h2>
      </div>

      <div class="clients-skills__aside">
        <div class="clients-skills__visuals" aria-hidden="true">
          {
            clients.items.map((client) => (
              <div
                class="clients-skills__visual"
                id={`client-visual-${client.id}`}
                data-visual={client.id}
              >
                <Picture
                  webpSrcSet={client.webpSrcSet}
                  fallbackSrcSet={client.fallbackSrcSet}
                  fallbackType={client.fallbackType}
                  src={client.fallbackSrc}
                  alt=""
                  sizes="34vw"
                  width={client.width}
                  height={client.height}
                  class="clients-skills__img"
                />
              </div>
            ))
          }
        </div>

        <div class="clients-skills__skills">
          <p class="clients-skills__caption">My Skills</p>
          <ul class="clients-skills__list" role="list">
            {
              skills.items.map((skill) => (
                <li>
                  <TextLink href={skill.href} label={skill.label} variant="invert" />
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function initClientHovers() {
    const root = document.querySelector('.clients-skills');
    if (!(root instanceof HTMLElement)) return;

    const buttons = root.querySelectorAll('[data-client]');
    const visuals = root.querySelectorAll('[data-visual]');
    if (buttons.length === 0 || visuals.length === 0) return;

    const activate = (id: string | null) => {
      visuals.forEach((visual) => {
        if (!(visual instanceof HTMLElement)) return;
        visual.classList.toggle('is-active', Boolean(id) && visual.dataset.visual === id);
      });
    };

    const clear = () => activate(null);

    buttons.forEach((button) => {
      if (!(button instanceof HTMLButtonElement)) return;
      const id = button.dataset.client;
      if (!id) return;
      button.addEventListener('mouseenter', () => activate(id));
      button.addEventListener('focus', () => activate(id));
      button.addEventListener('mouseleave', clear);
      button.addEventListener('blur', clear);
    });
  }

  initClientHovers();
  document.addEventListener('astro:page-load', initClientHovers);
</script>

<style>
  .clients-skills {
    background: var(--color-black);
    color: var(--color-white);
    padding-block: clamp(3rem, 8vw, 6rem) 0;
  }

  .clients-skills__grid {
    display: flex;
    flex-wrap: wrap;
    width: 100%;
  }

  .clients-skills__copy,
  .clients-skills__aside {
    width: 100%;
    padding: clamp(0.75rem, 1.5vw, 1.5rem);
  }

  .clients-skills__heading {
    position: relative;
    z-index: 2;
    font-size: clamp(1.75rem, 2.5vw, 2.5rem);
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1.25;
  }

  /* .accident-word — colored underlines match live classes */
  .clients-skills__name {
    appearance: none;
    display: inline-block;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    padding: 0;
    cursor: default;
    line-height: 1;
    box-shadow: inset 0 -3px 0 0 var(--color-white);
    transition: box-shadow 0.3s ease;
  }

  .clients-skills__name:hover,
  .clients-skills__name:focus-visible {
    box-shadow: inset 0 0 0 0 var(--color-white);
  }

  /* .accident-word.singularity-net */
  .clients-skills__name--singularitynet {
    color: #fff;
    box-shadow: inset 0 -3px #0d6efd;
  }

  .clients-skills__name--singularitynet:hover,
  .clients-skills__name--singularitynet:focus-visible {
    box-shadow: inset 0 0 #0d6efd;
  }

  /* .accident-word.hanson-robotics */
  .clients-skills__name--hanson {
    box-shadow: inset 0 -3px #ff3d00;
  }

  .clients-skills__name--hanson:hover,
  .clients-skills__name--hanson:focus-visible {
    box-shadow: inset 0 0 #ff3d00;
  }

  /* .accident-word.coredao */
  .clients-skills__name--coredao {
    box-shadow: inset 0 -3px #eec55a;
  }

  .clients-skills__name--coredao:hover,
  .clients-skills__name--coredao:focus-visible {
    box-shadow: inset 0 0 #eec55a;
  }

  /* .accident-word.playasia */
  .clients-skills__name--playasia {
    box-shadow: inset 0 -3px #2e3d5d;
  }

  .clients-skills__name--playasia:hover,
  .clients-skills__name--playasia:focus-visible {
    box-shadow: inset 0 0 #fef2c9;
  }

  .clients-skills__visuals {
    display: none;
  }

  .clients-skills__caption {
    margin-bottom: 1rem;
    color: color-mix(in srgb, var(--color-white) 55%, transparent);
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .clients-skills__list {
    display: grid;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .clients-skills__list :global(.text-link) {
    width: 100%;
    min-width: 0;
    text-transform: none;
    letter-spacing: 0;
    font-size: clamp(1.25rem, 2vw, 2rem);
    border-bottom-color: color-mix(in srgb, var(--color-white) 25%, transparent);
  }

  .clients-skills__list :global(.text-link:hover) {
    background: transparent;
    padding-inline: 0.35rem;
  }

  @media (min-width: 992px) {
    .clients-skills__copy {
      position: relative;
      z-index: 2;
      width: 45%;
    }

    .clients-skills__aside {
      position: relative;
      z-index: 1;
      width: 55%;
      display: flex;
      gap: 1.5rem;
      align-items: flex-end;
    }

    /* .offset-image-wrapper — sits under the left heading text */
    .clients-skills__visuals {
      display: flex;
      justify-content: flex-end;
      position: relative;
      z-index: 0;
      width: 30%;
      min-height: 22.4vw;
    }

    .clients-skills__skills {
      position: relative;
      z-index: 2;
    }

    /* .offset-image — hidden until hover (opacity: 0) */
    .clients-skills__visual {
      position: absolute;
      z-index: 0;
      right: 1.5em;
      bottom: 0;
      width: 34vw;
      height: 22.4vw;
      max-width: 28rem;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
      overflow: hidden;
    }

    .clients-skills__visual.is-active {
      opacity: 1;
    }

    .clients-skills__visual :global(.clients-skills__img),
    .clients-skills__visual :global(picture) {
      display: block;
      width: 100%;
      height: 100%;
    }

    .clients-skills__visual :global(.clients-skills__img) {
      object-fit: cover;
    }

    .clients-skills__skills {
      flex: 1;
    }
  }
</style>
