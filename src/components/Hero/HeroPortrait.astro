---
import Picture from '../ui/Picture.astro';
import { hero } from '../../data/site';

const { portrait } = hero;
---

<!-- Live: .hero-image-wrapper > img.image.hero — height 33vw / img 90% -->
<figure class="hero-portrait">
  <Picture
    webpSrcSet={portrait.webpSrcSet}
    fallbackSrcSet={portrait.fallbackSrcSet}
    fallbackType={portrait.fallbackType}
    src={portrait.fallbackSrc}
    alt={portrait.alt}
    sizes="(max-width: 767px) 100vw, (max-width: 991px) 728px, 940px"
    width={portrait.width}
    height={portrait.height}
    class="hero-portrait__img"
    loading="eager"
    fetchpriority="high"
  />
</figure>

<style>
  /* Live: .hero-image-wrapper */
  .hero-portrait {
    margin: 0;
    width: 100%;
    height: 33vw;
    overflow: hidden;
    background: var(--color-bg);
  }

  /* Let the img size against the figure like live's direct-child img */
  .hero-portrait :global(picture) {
    display: contents;
  }

  /*
    Live: .image { object-fit: cover; width: 100%; height: 100%;
                   margin-bottom: 30px; padding-top/bottom: 1% }
         .image.hero { height: 90%; overflow: visible }
  */
  .hero-portrait :global(.hero-portrait__img) {
    display: inline-block;
    width: 100%;
    height: 90%;
    max-width: 100%;
    object-fit: cover;
    object-position: 50% 50%;
    margin: 0 0 30px;
    padding: 1% 0;
    overflow: visible;
  }
</style>
