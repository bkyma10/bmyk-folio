---
import Picture from '../ui/Picture.astro';
import { hero } from '../../data/site';

const { portrait } = hero;
---

<figure class="hero-portrait">
  <Picture
    webpSrcSet={portrait.webpSrcSet}
    fallbackSrcSet={portrait.fallbackSrcSet}
    fallbackType={portrait.fallbackType}
    src={portrait.fallbackSrc}
    alt={portrait.alt}
    sizes="100vw"
    width={portrait.width}
    height={portrait.height}
    class="hero-portrait__img"
    loading="eager"
    fetchpriority="high"
  />
</figure>

<style>
  .hero-portrait {
    margin: 0;
    width: 100%;
    height: clamp(14rem, 33vw, 28rem);
    overflow: hidden;
    background: var(--color-bg);
  }

  .hero-portrait :global(.hero-portrait__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 18%;
  }
</style>
