---
import Picture from '../ui/Picture.astro';
import TextLink from '../ui/TextLink.astro';
import { hero, aboutIntro } from '../../data/site';
---

<!-- Live: .container-2.xs-top-padding — padding: 2em 6em 11em -->
<section class="intro" aria-label="About introduction" data-intro>
  <div class="intro__grid" data-section-blur>
    <div class="intro__gallery" aria-hidden="true">
      <!-- Live: data-w-id="ccd47627-9f8c-2109-2cb0-b87455ec5fc9" .images-wrapper -->
      <div class="intro__stack" data-intro-stack>
        <div class="intro__frame intro__frame--a" data-intro-frame="a">
          <Picture
            webpSrcSet={aboutIntro.playasia.webpSrcSet}
            fallbackSrcSet={aboutIntro.playasia.fallbackSrcSet}
            fallbackType={aboutIntro.playasia.fallbackType}
            src={aboutIntro.playasia.fallbackSrc}
            alt=""
            sizes="(max-width: 991px) 0px, 17em"
            width={960}
            height={1280}
            class="intro__img"
          />
        </div>
        <div class="intro__frame intro__frame--b" data-intro-frame="b">
          <Picture
            webpSrcSet={aboutIntro.sophiaverse.webpSrcSet}
            fallbackSrcSet={aboutIntro.sophiaverse.fallbackSrcSet}
            fallbackType={aboutIntro.sophiaverse.fallbackType}
            src={aboutIntro.sophiaverse.fallbackSrc}
            alt=""
            sizes="(max-width: 991px) 0px, 17em"
            width={960}
            height={1280}
            class="intro__img"
          />
        </div>
      </div>
    </div>

    <div class="intro__copy">
      <div class="intro__cover">
        <Picture
          webpSrcSet={aboutIntro.corecover.webpSrcSet}
          fallbackSrcSet={aboutIntro.corecover.fallbackSrcSet}
          fallbackType={aboutIntro.corecover.fallbackType}
          src={aboutIntro.corecover.fallbackSrc}
          alt={aboutIntro.corecover.alt}
          sizes="(max-width: 767px) 100vw, 55vw"
          width={960}
          height={720}
          class="intro__cover-img"
        />
      </div>
      <p class="intro__summary">{hero.summary}</p>
      <div class="intro__cta">
        <TextLink href={hero.cta.href} label={hero.cta.label} />
      </div>
    </div>
  </div>
</section>

<script>
  /**
   * Mirrors live Webflow IX2:
   * - a-89 / e-191: SCROLLING_IN_VIEW on .images-wrapper
   *   frame A → translateY 0% → 140%
   *   frame B → translateY 0% → -120%
   *   smoothing: 50
   * - a-55 / e-190: SCROLLING_IN_VIEW on .container-2
   *   .aspect-ratio-img (cover) → scale 1 → 1.3
   *   smoothing: 80
   */
  function initIntroScrollMotion() {
    const root = document.querySelector('[data-intro]');
    if (!(root instanceof HTMLElement)) return;

    const stack = root.querySelector('[data-intro-stack]');
    const frameA = root.querySelector('[data-intro-frame="a"]');
    const frameB = root.querySelector('[data-intro-frame="b"]');
    const cover = root.querySelector('.intro__cover-img');

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion) return;

    const clamp01 = (value: number) => Math.min(1, Math.max(0, value));

    /** Webflow SCROLLING_IN_VIEW progress: 0 when entering viewport, 1 when exiting. */
    const scrollProgress = (el: Element) => {
      const rect = el.getBoundingClientRect();
      const viewH = window.innerHeight || 1;
      const start = viewH;
      const end = -rect.height;
      return clamp01((start - rect.top) / (start - end));
    };

    /** Exponential smoothing toward target (Webflow smoothing ~50–80). */
    const smoothToward = (current: number, target: number, amount: number) =>
      current + (target - current) * amount;

    let stackProgress = 0;
    let coverProgress = 0;
    let raf = 0;
    let running = false;

    const tick = () => {
      const stackTarget = stack ? scrollProgress(stack) : 0;
      const coverTarget = scrollProgress(root);

      // smoothing 50 ≈ snappier; 80 ≈ heavier — map to lerp factors
      stackProgress = smoothToward(stackProgress, stackTarget, 0.12);
      coverProgress = smoothToward(coverProgress, coverTarget, 0.08);

      if (frameA instanceof HTMLElement) {
        frameA.style.transform = `translate3d(0, ${stackProgress * 140}%, 0)`;
      }
      if (frameB instanceof HTMLElement) {
        frameB.style.transform = `translate3d(0, ${stackProgress * -120}%, 0)`;
      }
      if (cover instanceof HTMLElement) {
        const scale = 1 + coverProgress * 0.3;
        cover.style.transform = `scale3d(${scale}, ${scale}, 1)`;
      }

      const settled =
        Math.abs(stackProgress - stackTarget) < 0.001 &&
        Math.abs(coverProgress - coverTarget) < 0.001;

      if (settled) {
        running = false;
        raf = 0;
        return;
      }
      raf = requestAnimationFrame(tick);
    };

    const kick = () => {
      if (running) return;
      running = true;
      raf = requestAnimationFrame(tick);
    };

    window.addEventListener('scroll', kick, { passive: true });
    window.addEventListener('resize', kick);
    kick();

    document.addEventListener(
      'astro:before-swap',
      () => {
        window.removeEventListener('scroll', kick);
        window.removeEventListener('resize', kick);
        if (raf) cancelAnimationFrame(raf);
      },
      { once: true },
    );
  }

  initIntroScrollMotion();
  document.addEventListener('astro:page-load', initIntroScrollMotion);
</script>

<style>
  .intro {
    /* Live .container-2.xs-top-padding keeps 2em / 11em vertical in ems */
    padding: 2em var(--space-page-x) 11em;
  }

  .intro__grid {
    display: flex;
    flex-wrap: wrap;
    width: 100%;
  }

  .intro__gallery {
    display: none;
  }

  .intro__copy {
    width: 100%;
    padding: var(--space-grid-item);
  }

  .intro__cover {
    position: relative;
    width: 100%;
    height: 26em;
    margin-bottom: 3em;
    overflow: hidden;
    background: transparent;
  }

  .intro__cover :global(.intro__cover-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform-origin: 50% 50%;
    will-change: transform;
  }

  /* Live .description-lg — Inter 1.3em / 300; line-height inherits body 1.4 */
  .intro__summary {
    color: var(--color-grey-80);
    font-family: var(--font-body);
    font-size: 1.3em;
    font-weight: 300;
    line-height: 1.4;
    /* Live uses .spacer._40 (40px) after the paragraph */
    margin-bottom: 40px;
  }

  /* Live .link-2.small.portfolio — 40% desktop, 100% ≤991 */
  .intro__cta :global(.text-link) {
    width: 40%;
    min-width: auto;
  }

  @media screen and (max-width: 991px) {
    /* Live .description-lg { font-size: 16px } */
    .intro__summary {
      font-size: 16px;
    }

    .intro__cta :global(.text-link) {
      width: 100%;
    }
  }

  /* Live .img-wrapper { display: none } ≤767 */
  @media screen and (max-width: 767px) {
    .intro__cover {
      display: none;
    }
  }

  @media screen and (max-width: 479px) {
    /* Live .description-lg + .personal-desc */
    .intro__summary {
      font-size: 16px;
      font-weight: 400;
      text-align: left;
      margin-bottom: 30px;
    }
  }

  @media (min-width: 992px) {
    .intro__gallery {
      display: block;
      width: 45%;
      padding: var(--space-grid-item);
    }

    .intro__copy {
      width: 55%;
    }

    .intro__stack {
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      min-height: 100%;
      gap: 1.5em;
      padding-right: 4em;
    }

    .intro__frame {
      position: relative;
      width: 17em;
      aspect-ratio: 3 / 4;
      overflow: hidden;
      background: var(--color-bg);
      will-change: transform;
    }

    .intro__frame--b {
      margin-left: auto;
    }

    .intro__frame :global(.intro__img) {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .intro__frame,
    .intro__cover :global(.intro__cover-img) {
      will-change: auto;
      transform: none !important;
    }
  }
</style>
