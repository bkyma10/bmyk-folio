---
import LocationBadge from './LocationBadge.astro';
import HeroPortrait from './HeroPortrait.astro';
import { hero } from '../../data/site';
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="hero__top section-pad">
    <div class="hero__location">
      <LocationBadge />
    </div>
    <h1 id="hero-heading" class="hero__title">
      {hero.greeting}<br />
      {hero.role}
    </h1>
    <div class="hero__media">
      <HeroPortrait />
    </div>
  </div>
</section>

<style>
  .hero__top {
    padding-top: calc(var(--header-height) + clamp(1.5rem, 3vw, 3rem));
    display: flex;
    flex-wrap: wrap;
    width: 100%;
  }

  .hero__location,
  .hero__title,
  .hero__media {
    width: 100%;
    padding: clamp(0.75rem, 1.5vw, 1.5rem);
  }

  .hero__location {
    width: 85%;
  }

  .hero__title {
    font-size: clamp(2rem, 3.5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.1;
    text-transform: none;
  }

  .hero__media {
    padding-top: 0.5rem;
  }

  @media (max-width: 767px) {
    .hero__location {
      width: 100%;
    }
  }
</style>
