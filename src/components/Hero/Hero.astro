---
import LocationBadge from './LocationBadge.astro';
import HeroPortrait from './HeroPortrait.astro';
import { hero } from '../../data/site';
---

<section class="hero" aria-labelledby="hero-heading">
  <!-- Live: .container.hero — padding: 4em 6em 0 -->
  <div class="hero__top">
    <div class="hero__location">
      <LocationBadge />
    </div>
    <h1 id="hero-heading" class="hero__title">
      {hero.greeting}<br />
      {hero.role}
    </h1>
    <div class="hero__media">
      <HeroPortrait />
    </div>
  </div>
</section>

<style>
  .hero__top {
    display: flex;
    flex-wrap: wrap;
    width: 100%;
    padding: 4em var(--space-page-x) 0;
  }

  .hero__location,
  .hero__title,
  .hero__media {
    width: 100%;
    padding: var(--space-grid-item);
  }

  .hero__location {
    width: 85%;
  }

  .hero__title {
    font-size: 3.5em;
    font-weight: 700;
    line-height: 1.1;
    text-transform: none;
  }

  .hero__media {
    padding-top: 0.5em;
  }

  @media screen and (max-width: 991px) {
    .hero__top {
      padding-top: 80px;
    }

    .hero__title {
      font-size: 42px;
    }
  }

  @media screen and (max-width: 767px) {
    .hero__location {
      width: 100%;
    }

    .hero__title {
      font-size: 32px;
    }
  }

  @media screen and (max-width: 479px) {
    .hero__top {
      padding-top: 80px;
    }
  }
</style>
