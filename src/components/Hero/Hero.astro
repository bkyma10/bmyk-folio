---
import LocationBadge from './LocationBadge.astro';
import HeroPortrait from './HeroPortrait.astro';
import { hero } from '../../data/site';
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="hero__grid">
    <div class="hero__meta hero__reveal" style="--reveal-delay: 0.1s">
      <LocationBadge />
    </div>

    <div class="hero__copy hero__reveal" style="--reveal-delay: 0.22s">
      <h1 id="hero-heading" class="hero__title">
        <span class="hero__greeting">{hero.greeting}</span>
        <span class="hero__role">{hero.role}</span>
      </h1>
    </div>

    <div class="hero__media hero__reveal" style="--reveal-delay: 0.34s">
      <HeroPortrait />
    </div>

    <div class="hero__supporting hero__reveal" style="--reveal-delay: 0.46s">
      <p class="hero__summary">{hero.summary}</p>
      <a class="hero__cta" href={hero.cta.href}>
        <span>{hero.cta.label}</span>
        <span class="hero__cta-arrow" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
            <path
              fill-rule="evenodd"
              clip-rule="evenodd"
              d="M2.06066 1H23.5607V22.5H20.5607V6.12132L3.12132 23.5607L1 21.4393L18.4393 4H2.06066V1Z"
              fill="currentColor"
            />
          </svg>
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: calc(var(--header-height) + 2rem) var(--space-page-x) 3rem;
    max-width: var(--max-content);
    margin-inline: auto;
  }

  .hero__grid {
    display: grid;
    gap: 1.5rem;
  }

  .hero__title {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: clamp(2.15rem, 6.5vw, 3.75rem);
    font-weight: 700;
    color: var(--color-black);
  }

  .hero__greeting,
  .hero__role {
    display: block;
  }

  .hero__summary {
    margin: 0;
    max-width: 38rem;
    color: var(--color-grey-80);
    font-size: clamp(1rem, 1.35vw, 1.2rem);
    font-weight: 400;
    line-height: 1.65;
  }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--color-black);
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    transition:
      gap var(--duration-med) var(--ease-out),
      opacity var(--duration-fast) ease;
  }

  .hero__cta:hover {
    gap: 1rem;
    opacity: 0.7;
  }

  .hero__cta-arrow {
    display: inline-flex;
    width: 1rem;
    height: 1rem;
  }

  .hero__cta-arrow svg {
    width: 100%;
    height: 100%;
  }

  .hero__reveal {
    opacity: 0;
    transform: translateY(1.25rem);
    animation: hero-rise var(--duration-slow) var(--ease-out) var(--reveal-delay, 0s) forwards;
  }

  @keyframes hero-rise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (min-width: 768px) {
    .hero {
      padding-top: calc(var(--header-height) + 2.5rem);
      padding-bottom: 4rem;
    }

    .hero__grid {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }

    .hero__supporting {
      display: grid;
      grid-template-columns: minmax(0, 0.95fr) auto;
      align-items: end;
      gap: 2rem;
    }

    .hero__cta {
      margin-top: 0;
      justify-self: end;
      white-space: nowrap;
    }
  }

  @media (min-width: 1024px) {
    .hero__grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .hero__media {
      max-height: 36vw;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__reveal {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>
