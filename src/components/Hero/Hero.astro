---
import LocationBadge from './LocationBadge.astro';
import HeroPortrait from './HeroPortrait.astro';
import { hero } from '../../data/site';
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="hero__intro">
    <div class="hero__meta hero__reveal" style="--reveal-delay: 0.08s">
      <LocationBadge />
    </div>

    <div class="hero__copy hero__reveal" style="--reveal-delay: 0.18s">
      <h1 id="hero-heading" class="hero__title">
        <span class="hero__greeting">{hero.greeting}</span>
        <span class="hero__role">{hero.role}</span>
      </h1>
      <p class="hero__summary">{hero.summary}</p>
      <a class="hero__cta" href={hero.cta.href}>
        <span>{hero.cta.label}</span>
        <span class="hero__cta-arrow" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
            <path
              fill-rule="evenodd"
              clip-rule="evenodd"
              d="M2.06066 1H23.5607V22.5H20.5607V6.12132L3.12132 23.5607L1 21.4393L18.4393 4H2.06066V1Z"
              fill="currentColor"
            />
          </svg>
        </span>
      </a>
    </div>
  </div>

  <div class="hero__media hero__reveal" style="--reveal-delay: 0.32s">
    <HeroPortrait />
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: calc(var(--header-height) + clamp(1.5rem, 4vw, 2.75rem));
  }

  .hero__intro {
    max-width: var(--max-content);
    margin-inline: auto;
    padding-inline: var(--space-page-x);
    display: grid;
    gap: 1.25rem;
  }

  .hero__title {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-bottom: 1.25rem;
    font-size: clamp(2.25rem, 6.8vw, 3.85rem);
    font-weight: 700;
    color: var(--color-black);
  }

  .hero__greeting,
  .hero__role {
    display: block;
  }

  .hero__summary {
    margin: 0;
    max-width: 40rem;
    color: var(--color-grey-80);
    font-size: clamp(1rem, 1.35vw, 1.2rem);
    font-weight: 400;
    line-height: 1.65;
  }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--color-black);
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    transition:
      gap var(--duration-med) var(--ease-out),
      opacity var(--duration-fast) ease;
  }

  .hero__cta:hover {
    gap: 1rem;
    opacity: 0.7;
  }

  .hero__cta-arrow {
    display: inline-flex;
    width: 1rem;
    height: 1rem;
  }

  .hero__cta-arrow svg {
    width: 100%;
    height: 100%;
  }

  .hero__media {
    margin-top: clamp(1.75rem, 4vw, 2.75rem);
    width: 100%;
  }

  .hero__reveal {
    opacity: 0;
    transform: translateY(1.25rem);
    animation: hero-rise var(--duration-slow) var(--ease-out) var(--reveal-delay, 0s) forwards;
  }

  @keyframes hero-rise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (min-width: 900px) {
    .hero__intro {
      grid-template-columns: auto 1fr;
      align-items: start;
      column-gap: 2rem;
    }

    .hero__meta {
      padding-top: 0.35rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__reveal {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>
