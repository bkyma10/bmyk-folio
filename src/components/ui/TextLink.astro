---
interface Props {
  href: string;
  label: string;
  variant?: 'dark' | 'light' | 'invert';
  external?: boolean;
}

const { href, label, variant = 'dark', external = false } = Astro.props;
---

<a
  class:list={['text-link', `text-link--${variant}`]}
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
>
  <span class="text-link__label">{label}</span>
  <span class="text-link__arrow" aria-hidden="true">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
      <path
        fill-rule="evenodd"
        clip-rule="evenodd"
        d="M2.06066 1H23.5607V22.5H20.5607V6.12132L3.12132 23.5607L1 21.4393L18.4393 4H2.06066V1Z"
        fill="currentColor"></path>
    </svg>
  </span>
</a>

<style>
  .text-link {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    width: fit-content;
    min-width: 12em;
    padding: 0.5em 0;
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1.1;
    transition: padding var(--duration-med) ease, background-color var(--duration-med) ease;
  }

  .text-link:hover {
    padding-left: 0.5em;
    padding-right: 0.5em;
  }

  .text-link--dark {
    color: var(--color-black);
  }

  .text-link--dark:hover {
    background: var(--color-grey-8);
  }

  .text-link--light,
  .text-link--invert {
    color: var(--color-white);
  }

  .text-link__arrow {
    display: inline-flex;
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
    /* Live IX2: Hover In/Out On Link Big — rotateZ 0→45deg, 500ms outQuart */
    transform: rotate(0deg);
    transition: transform var(--duration-arrow) var(--ease-out-quart);
  }

  .text-link:hover .text-link__arrow,
  .text-link:focus-visible .text-link__arrow {
    transform: rotate(45deg);
  }

  .text-link__arrow svg {
    width: 100%;
    height: 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    .text-link__arrow {
      transition: none;
    }

    .text-link:hover .text-link__arrow,
    .text-link:focus-visible .text-link__arrow {
      transform: none;
    }
  }
</style>
