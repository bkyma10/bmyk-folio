---
interface Props {
  webpSrcSet: string;
  fallbackSrcSet?: string;
  fallbackType?: 'image/jpeg' | 'image/png';
  src: string;
  alt: string;
  sizes: string;
  width: number;
  height: number;
  class?: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
}

const {
  webpSrcSet,
  fallbackSrcSet,
  fallbackType = 'image/jpeg',
  src,
  alt,
  sizes,
  width,
  height,
  class: className = '',
  loading = 'lazy',
  fetchpriority = 'auto',
} = Astro.props;
---

<picture>
  <source type="image/webp" srcset={webpSrcSet} sizes={sizes} />
  {
    fallbackSrcSet && (
      <source type={fallbackType} srcset={fallbackSrcSet} sizes={sizes} />
    )
  }
  <img
    src={src}
    alt={alt}
    width={width}
    height={height}
    sizes={sizes}
    loading={loading}
    decoding="async"
    fetchpriority={fetchpriority}
    class={className}
  />
</picture>
