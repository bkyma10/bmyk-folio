---
interface Props {
  eyebrow?: string;
  title: string;
  id?: string;
  tone?: 'light' | 'dark';
}

const { eyebrow, title, id, tone = 'light' } = Astro.props;
---

<header class:list={['section-heading', tone === 'dark' && 'section-heading--dark']}>
  {eyebrow && <p class="section-heading__eyebrow">{eyebrow}</p>}
  <h2 class="section-heading__title" id={id}>{title}</h2>
</header>

<style>
  .section-heading {
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .section-heading__eyebrow {
    margin: 0 0 0.65rem;
    color: var(--color-grey-60);
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .section-heading__title {
    font-size: clamp(1.85rem, 4vw, 2.75rem);
    font-weight: 700;
    color: var(--color-black);
  }

  .section-heading--dark .section-heading__title {
    color: var(--color-white);
  }

  .section-heading--dark .section-heading__eyebrow {
    color: color-mix(in srgb, var(--color-white) 65%, transparent);
  }
</style>
