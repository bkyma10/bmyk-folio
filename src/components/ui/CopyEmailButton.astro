---
import { site } from '../../data/site';

interface Props {
  variant?: 'nav' | 'footer';
}

const { variant = 'footer' } = Astro.props;
const isNav = variant === 'nav';
---

<button
  type="button"
  class:list={['copy-email', isNav && 'copy-email--nav']}
  data-copy-email={site.email}
  aria-label={`Copy email address ${site.email}`}
>
  <span class="copy-email__inner">
    {/* Text filled from data-copy-email so Cloudflare email obfuscation cannot rewrite it */}
    <span class="copy-email__label" data-copy-label></span>
    <span class="copy-email__icon" aria-hidden="true">
      <!-- Live Font Awesome "copy" (U+F0C5) — two overlapping documents -->
      <svg width="1em" height="1em" viewBox="0 0 512 512" fill="currentColor" aria-hidden="true">
        <path
          d="M224 0c-35.3 0-64 28.7-64 64V288c0 35.3 28.7 64 64 64H448c35.3 0 64-28.7 64-64V64c0-35.3-28.7-64-64-64H224zM64 160c-35.3 0-64 28.7-64 64V448c0 35.3 28.7 64 64 64H288c35.3 0 64-28.7 64-64V384H288v64H64V224h64V160H64z"
        ></path>
      </svg>
    </span>
  </span>
</button>

<style>
  /* Live .footer-button */
  .copy-email {
    display: flex;
    position: relative;
    align-items: center;
    justify-content: center;
    min-width: 7vw;
    height: auto;
    margin: 0;
    padding: 16px 32px;
    overflow: hidden;
    border: 0;
    border-radius: 999px;
    background-color: #fff;
    box-shadow: none;
    color: #0d0d11;
    font-family: var(--font-display);
    font-size: 1em;
    font-variation-settings: 'wdth' 75, 'wght' 450;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      transform 0.5s cubic-bezier(0.23, 1, 0.32, 1),
      box-shadow 0.5s;
  }

  .copy-email:hover {
    transform: scale(1.05);
  }

  /* Live .footer-button.nav */
  .copy-email--nav {
    padding: 8px 16px;
  }

  .copy-email__inner {
    display: flex;
    position: relative;
    align-items: center;
    overflow: hidden;
    text-align: center;
  }

  /* Live .link-label */
  .copy-email__label {
    position: relative;
    font-size: 1.5em;
    text-transform: none;
    white-space: nowrap;
  }

  .copy-email--nav .copy-email__label {
    font-size: 1em;
  }

  /* Live .fa-icon */
  .copy-email__icon {
    display: flex;
    align-items: center;
    padding-left: 10px;
    font-size: 1.5em;
    line-height: 1;
    color: #0d0d11;
  }

  .copy-email--nav .copy-email__icon {
    font-size: 1em;
  }

  .copy-email__icon svg {
    width: 0.875em;
    height: 0.875em;
  }

  @media screen and (max-width: 991px) {
    .copy-email:not(.copy-email--nav) {
      min-width: 10vw;
      height: 10vw;
      padding-left: 5vw;
      padding-right: 5vw;
    }

    .copy-email--nav {
      min-width: 7vw;
      height: auto;
      background-color: var(--color-black);
      color: var(--color-white);
    }

    .copy-email:not(.copy-email--nav) .copy-email__label {
      font-size: 20px;
    }

    .copy-email--nav .copy-email__label {
      color: var(--color-white);
      font-size: 14px;
    }

    .copy-email:not(.copy-email--nav) .copy-email__icon {
      color: var(--color-black);
    }

    .copy-email--nav .copy-email__icon {
      color: var(--color-white);
    }
  }

  @media screen and (max-width: 767px) {
    .copy-email:not(.copy-email--nav) {
      font-size: 0.75rem;
    }
  }

  @media screen and (max-width: 479px) {
    .copy-email:not(.copy-email--nav) {
      flex: 1;
      min-width: 15vw;
      height: 15vw;
      padding-left: 7.5vw;
      padding-right: 7.5vw;
    }

    .copy-email:not(.copy-email--nav) .copy-email__label {
      font-size: 15px;
    }
  }
</style>

<script>
  function initCopyEmailButtons() {
    document.querySelectorAll<HTMLButtonElement>('[data-copy-email]').forEach((button) => {
      const email = button.dataset.copyEmail;
      const label = button.querySelector('[data-copy-label]');
      if (!email || !label) return;

      // Populate after paint so edge email-obfuscation cannot rewrite the label
      if (!label.textContent) label.textContent = email;

      if (button.dataset.copyBound === '1') return;
      button.dataset.copyBound = '1';

      button.addEventListener('click', async () => {
        const original = email;
        try {
          await navigator.clipboard.writeText(email);
          label.textContent = 'Copied to clipboard!';
        } catch {
          window.location.href = `mailto:${email}`;
          return;
        }

        window.setTimeout(() => {
          label.textContent = original;
        }, 1800);
      });
    });
  }

  initCopyEmailButtons();
  document.addEventListener('astro:page-load', initCopyEmailButtons);
</script>
