---
import Picture from '../ui/Picture.astro';
import { stories } from '../../data/site';
---

<!-- Live: .container-4.inner-hero — padding-top 6em, sides 4em, bottom 11em -->
<section class="stories" aria-labelledby="stories-heading">
  <div class="stories__inner">
    <h2 id="stories-heading" class="stories__heading">My Stories</h2>
    <ul class="stories__grid" role="list">
      {
        stories.items.map((story) => (
          <li class="stories__item">
            <a class="stories__media" href={story.href}>
              <Picture
                webpSrcSet={story.webpSrcSet}
                fallbackSrcSet={story.fallbackSrcSet}
                fallbackType={story.fallbackType}
                src={story.fallbackSrc}
                alt={story.alt}
                sizes="(max-width: 767px) 100vw, 25vw"
                width={story.width}
                height={story.height}
                class="stories__img"
              />
            </a>
            <p class="stories__category">{story.category}</p>
            <h3 class="stories__title">{story.title}</h3>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .stories {
    background: var(--color-white);
  }

  .stories__inner {
    /* Live container-4 uses 4em horizontal (not 6em) */
    padding: 6em 4em var(--space-section-y);
  }

  .stories__heading {
    margin-bottom: 2.5em;
    font-size: 2.5em;
    font-weight: 500;
  }

  .stories__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2em 1.5em;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stories__media {
    display: block;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--color-bg);
    margin-bottom: 0.75em;
  }

  .stories__media :global(.stories__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.8) contrast(0.93);
    transition: transform var(--duration-slow) var(--ease-out);
  }

  @media (prefers-reduced-motion: no-preference) {
    .stories__item:hover :global(.stories__img) {
      transform: scale(1.03);
    }
  }

  .stories__category {
    margin-bottom: 0.75em;
    color: var(--color-grey-60);
    font-size: 0.8em;
    font-weight: 500;
  }

  .stories__title {
    font-size: 1.375em;
    font-weight: 500;
    line-height: 1.25;
  }

  @media screen and (max-width: 991px) {
    .stories__inner {
      padding: 120px 32px 72px;
    }

    .stories__heading {
      font-size: 32px;
    }
  }

  @media screen and (max-width: 767px) {
    .stories__inner {
      padding: 6em 12px 48px;
    }
  }

  @media screen and (max-width: 479px) {
    .stories__inner {
      padding-left: 12px;
      padding-right: 12px;
    }
  }

  @media (min-width: 640px) {
    .stories__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1024px) {
    .stories__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
