---
import TextLink from '../ui/TextLink.astro';
import { education, tools, experience, site } from '../../data/site';
---

<!-- Live: .section.grey-bg > .container.without-top-padding — 6em 6em 11em -->
<section class="resume" aria-label="Education, tools, and experience">
  <div class="resume__inner">
    <div class="resume__grid">
      <div class="resume__col">
        <div class="resume__block">
          <h2 class="resume__heading">Education</h2>
          <ul class="resume__list" role="list">
            {
              education.items.map((item) => (
                <li class="resume__item">
                  <p class="resume__title">{item.title}</p>
                  <p class="resume__meta">{item.org}</p>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="resume__block resume__block--tools">
          <h2 class="resume__heading">Tools</h2>
          <ul class="resume__tags" role="list">
            {tools.items.map((tool) => <li class="resume__tag">{tool}</li>)}
          </ul>
        </div>
      </div>

      <div class="resume__col">
        <h2 class="resume__heading">Experience</h2>
        <ul class="resume__list" role="list">
          {
            experience.items.map((item) => (
              <li class="resume__item resume__item--row">
                <div>
                  <p class="resume__title">{item.role}</p>
                  <p class="resume__meta">{item.company}</p>
                </div>
                <p class="resume__dates">{item.dates}</p>
              </li>
            ))
          }
        </ul>
        <div class="resume__cta">
          <TextLink href={site.resumeUrl} label={experience.resumeLabel} external />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .resume {
    background: var(--color-grey-8);
  }

  .resume__inner {
    padding: 6em var(--space-page-x) var(--space-section-y);
  }

  .resume__grid {
    display: flex;
    flex-wrap: wrap;
    width: 100%;
  }

  .resume__col {
    width: 100%;
    padding: var(--space-grid-item);
  }

  .resume__heading {
    margin-bottom: 3.5em;
    font-size: 2.5em;
    font-weight: 500;
  }

  @media screen and (max-width: 991px) {
    .resume__inner {
      padding-top: 72px;
      padding-bottom: 72px;
    }

    .resume__heading {
      font-size: 32px;
      margin-bottom: 32px;
    }
  }

  @media screen and (max-width: 767px) {
    .resume__inner {
      padding-top: 48px;
      padding-bottom: 48px;
    }
  }

  .resume__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .resume__item {
    border-top: 1px solid var(--color-grey-20);
    padding: 1.5em 0;
  }

  .resume__item--row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75em 1.5em;
  }

  .resume__title {
    font-family: var(--font-display);
    font-size: 1.05em;
    font-weight: 600;
    margin-bottom: 0.25em;
  }

  .resume__meta,
  .resume__dates {
    color: var(--color-grey-60);
    font-size: 0.95em;
  }

  .resume__block--tools {
    margin-top: 3.5em;
  }

  .resume__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5em;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .resume__tag {
    border: 1px solid var(--color-grey-20);
    border-radius: 50em;
    padding: 1em 2em;
    font-family: var(--font-body);
    font-size: 1em;
  }

  .resume__cta {
    margin-top: 2em;
  }

  @media (min-width: 992px) {
    .resume__col:first-child {
      width: 45%;
    }

    .resume__col:last-child {
      width: 55%;
    }
  }
</style>
