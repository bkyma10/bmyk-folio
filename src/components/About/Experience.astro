---
import SectionHeading from '../ui/SectionHeading.astro';
import TextLink from '../ui/TextLink.astro';
import { experience, site } from '../../data/site';
---

<section class="experience" aria-labelledby="experience-heading">
  <div class="experience__inner">
    <SectionHeading id="experience-heading" title={experience.heading} />
    <ol class="experience__list">
      {
        experience.items.map((item) => (
          <li class="experience__item">
            <div class="experience__role-block">
              <h3 class="experience__role">{item.role}</h3>
              <p class="experience__company">{item.company}</p>
            </div>
            <p class="experience__dates">
              <time>{item.dates}</time>
            </p>
          </li>
        ))
      }
    </ol>
    <div class="experience__cta">
      <TextLink href={site.resumeUrl} label={experience.resumeLabel} external />
    </div>
  </div>
</section>

<style>
  .experience {
    padding: 0 0 clamp(3rem, 7vw, 5.5rem);
  }

  .experience__inner {
    max-width: var(--max-content);
    margin-inline: auto;
    padding-inline: var(--space-page-x);
  }

  .experience__list {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .experience__item {
    display: grid;
    gap: 0.35rem;
    border-top: 1px solid var(--color-grey-20);
    padding: 1.15rem 0;
  }

  .experience__role {
    font-size: clamp(1.15rem, 2vw, 1.35rem);
    font-weight: 600;
  }

  .experience__company,
  .experience__dates {
    margin: 0;
    color: var(--color-grey-60);
  }

  .experience__cta {
    margin-top: 1.75rem;
  }

  @media (min-width: 768px) {
    .experience__item {
      grid-template-columns: 1fr auto;
      align-items: baseline;
      gap: 1.5rem;
    }

    .experience__dates {
      text-align: right;
      white-space: nowrap;
    }
  }
</style>
