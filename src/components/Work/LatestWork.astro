---
import Picture from '../ui/Picture.astro';
import { latestWork } from '../../data/site';
---

<!--
  Mirrors live Webflow hierarchy:
  .section.dark-bg > .container.without-top-padding > .grid > .grid-item
    > h3.h2 + .spacer._56 + .home-project-grid > .tile-grid-item
-->
<section class="work" aria-labelledby="work-heading">
  <div class="work__container">
    <div class="work__row" data-section-blur>
      <div class="work__item">
        <h2 id="work-heading" class="work__heading">{latestWork.heading}</h2>
        <div class="work__spacer" aria-hidden="true"></div>
        <ul class="work__grid" role="list">
          {
            latestWork.items.map((item) => (
              <li class="work__tile">
                <a class="work__link" href={item.href} data-view-cursor>
                  <div class="work__media">
                    <Picture
                      webpSrcSet={item.webpSrcSet}
                      fallbackSrcSet={item.fallbackSrcSet}
                      fallbackType={item.fallbackType}
                      src={item.fallbackSrc}
                      alt={item.alt}
                      sizes="(max-width: 767px) 100vw, (max-width: 991px) 727px, 939px"
                      width={item.width}
                      height={item.height}
                      loading="eager"
                      class="work__img"
                    />
                    <span class="work__arrow" aria-hidden="true">
                      <svg
                        width="100%"
                        height="100%"
                        viewBox="0 0 24 24"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                      >
                        <path
                          fill-rule="evenodd"
                          clip-rule="evenodd"
                          d="M2.06066 1H23.5607V22.5H20.5607V6.12132L3.12132 23.5607L1 21.4393L18.4393 4H2.06066V1Z"
                          fill="currentColor"
                        />
                      </svg>
                    </span>
                    <div class="work__tint">
                      <h3 class="work__title">{item.title}</h3>
                    </div>
                  </div>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .work {
    width: 100%;
    position: relative;
    background-color: var(--color-black);
    color: var(--color-white);
  }

  /* .container.without-top-padding — 6em 6em 11em */
  .work__container {
    z-index: 1;
    position: relative;
    max-width: none;
    height: 100%;
    padding: 6em var(--space-page-x) var(--space-section-y);
  }

  /* .grid */
  .work__row {
    display: flex;
    flex-flow: wrap;
    justify-content: flex-start;
    align-items: flex-start;
    width: 100%;
    position: relative;
  }

  /* .grid-item */
  .work__item {
    width: 100%;
    padding: 1.5em;
    position: relative;
    overflow: visible;
  }

  /* .h2 */
  .work__heading {
    z-index: 1;
    position: relative;
    margin: 0;
    letter-spacing: 0.02em;
    text-transform: none;
    font-size: 2.5em;
    font-weight: 500;
  }

  /* .spacer._56 */
  .work__spacer {
    height: 56px;
  }

  /* .home-project-grid */
  .work__grid {
    display: grid;
    grid-template-rows: auto auto;
    grid-template-columns: 1fr 1fr;
    grid-auto-columns: 1fr;
    grid-auto-flow: row;
    grid-column-gap: 0;
    grid-row-gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* .tile-grid-item */
  .work__tile {
    width: 100%;
  }

  /* .tile-img-wrapper.w-inline-block */
  .work__link {
    display: inline-block;
    max-width: 100%;
    width: 100%;
    height: 100%;
    min-height: 0;
    color: var(--color-white);
  }

  /* .aspect-ratio-height.project — always 40% on live */
  .work__media {
    position: relative;
    width: 100%;
    height: 100%;
    padding-top: 40%;
    overflow: hidden;
    background: #0d0f0e;
  }

  /* .aspect-ratio-img */
  .work__media :global(picture) {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .work__media :global(.work__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform-origin: 50% 0;
    will-change: transform;
    /* Live Webflow IX keeps tiles ~scaled while in view */
    transform: translate3d(0, 0, 0) scale3d(1.165, 1.165, 1);
    transition: transform 0.6s var(--ease-out);
  }

  /* .project-cover-tint — live uses #14151780 (= rgba(20,21,23,0.5)) */
  .work__tint {
    z-index: 1;
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    width: 100%;
    height: 100%;
    padding: 1.3em 4em 1.3em 1.3em;
    overflow: hidden;
    background-color: rgba(20, 21, 23, 0.5);
  }

  /* Live uses <h4 class="h3"> → h4 { font-size: 2em } on desktop */
  .work__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 2em;
    font-weight: 500;
    line-height: 1.2;
  }

  /* .project-arrow — inset: auto 1.3em 1.3em auto */
  .work__arrow {
    z-index: 2;
    position: absolute;
    right: 1.3em;
    bottom: 1.3em;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2em;
    height: 2em;
    color: var(--color-white);
    pointer-events: none;
    /* Live IX2: Hover In/Out on Project Tile — rotateZ 0→45deg, 500ms outQuart */
    transform: rotate(0deg);
    transition: transform var(--duration-arrow) var(--ease-out-quart);
  }

  .work__link:hover .work__arrow,
  .work__link:focus-visible .work__arrow {
    transform: rotate(45deg);
  }

  .work__arrow svg {
    width: 100%;
    height: 100%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .work__link:hover :global(.work__img),
    .work__link:focus-visible :global(.work__img) {
      transform: translate3d(0, 0, 0) scale3d(1.22, 1.22, 1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .work__media :global(.work__img) {
      transform: none;
    }

    .work__arrow {
      transition: none;
    }

    .work__link:hover .work__arrow,
    .work__link:focus-visible .work__arrow {
      transform: none;
    }
  }

  /* tablet — max-width: 991px
     Live .container.without-top-padding keeps padding-top: 6em;
     only bottom becomes 72px from .container */
  @media screen and (max-width: 991px) {
    .work__container {
      padding-top: 6em;
      padding-bottom: 72px;
    }

    .work__item {
      padding: var(--space-grid-item);
    }

    .work__heading {
      font-size: 32px;
    }

    .work__arrow {
      right: 2em;
      bottom: 2em;
    }

    .work__tint {
      padding: 2em;
    }

    .work__title {
      font-size: 24px;
    }

    .work__link {
      min-height: 200px;
    }
  }

  /* landscape / mobile — max-width: 767px
     Live still keeps padding-top: 6em (higher specificity than .container) */
  @media screen and (max-width: 767px) {
    .work__container {
      padding-top: 6em;
      padding-bottom: 48px;
    }

    .work__grid {
      grid-template-columns: 1fr;
      margin-left: 0;
    }

    .work__heading {
      margin-bottom: 0;
      font-size: 32px;
    }

    .work__arrow {
      width: 24px;
      height: 24px;
      right: 20px;
      bottom: 20px;
    }

    .work__tint {
      padding: 20px;
    }

    .work__title {
      font-size: 24px;
    }
  }

  /* phone — max-width: 479px — live finally sets padding-top: 48px */
  @media screen and (max-width: 479px) {
    .work__container {
      padding-top: 48px;
      padding-bottom: 48px;
    }

    .work__heading {
      font-size: 24px;
    }

    .work__link {
      height: 300px;
      min-height: 0;
    }

    .work__media {
      /* Fill the fixed-height wrapper on small phones (live .tile-img-wrapper height: 300px) */
      height: 100%;
      padding-top: 0;
    }
  }
</style>
