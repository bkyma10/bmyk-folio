---
import Picture from '../ui/Picture.astro';
import { latestWork } from '../../data/site';
---

<section class="work" aria-labelledby="work-heading">
  <div class="work__inner section-pad">
    <h2 id="work-heading" class="work__heading">Latest Work</h2>
    <ul class="work__grid" role="list">
      {
        latestWork.items.map((item) => (
          <li>
            <a class="work__tile" href={item.href}>
              <div class="work__media">
                <Picture
                  webpSrcSet={item.webpSrcSet}
                  fallbackSrcSet={item.fallbackSrcSet}
                  fallbackType={item.fallbackType}
                  src={item.fallbackSrc}
                  alt={item.alt}
                  sizes="(max-width: 767px) 100vw, 50vw"
                  width={item.width}
                  height={item.height}
                  class="work__img"
                />
                <div class="work__tint">
                  <h3 class="work__title">{item.title}</h3>
                </div>
                <span class="work__arrow" aria-hidden="true">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                    <path
                      fill-rule="evenodd"
                      clip-rule="evenodd"
                      d="M2.06066 1H23.5607V22.5H20.5607V6.12132L3.12132 23.5607L1 21.4393L18.4393 4H2.06066V1Z"
                      fill="currentColor"
                    />
                  </svg>
                </span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .work {
    background: var(--color-black);
    color: var(--color-white);
    padding: 0 0 clamp(3rem, 8vw, 6rem);
  }

  .work__heading {
    margin-bottom: clamp(1.5rem, 3.5vw, 3.5rem);
    padding: clamp(0.75rem, 1.5vw, 1.5rem);
    padding-bottom: 0;
    font-size: clamp(1.75rem, 2.5vw, 2.5rem);
    font-weight: 500;
  }

  .work__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .work__tile {
    display: block;
    color: var(--color-white);
  }

  .work__media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #0d0f0e;
  }

  .work__media :global(.work__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .work__tint {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    align-items: flex-end;
    padding: clamp(1rem, 1.3vw, 1.3rem) 3rem clamp(1rem, 1.3vw, 1.3rem) clamp(1rem, 1.3vw, 1.3rem);
    background: rgba(20, 21, 23, 0.5);
  }

  .work__title {
    font-size: clamp(1.15rem, 2vw, 1.75rem);
    font-weight: 500;
    line-height: 1.2;
  }

  .work__arrow {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 2;
    width: 1.25rem;
    height: 1.25rem;
    opacity: 0.9;
  }

  @media (prefers-reduced-motion: no-preference) {
    .work__tile:hover :global(.work__img) {
      transform: scale(1.04);
    }
  }

  @media (min-width: 768px) {
    .work__grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
