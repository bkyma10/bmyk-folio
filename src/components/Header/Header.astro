---
import Logo from './Logo.astro';
import NavLinks from './NavLinks.astro';
---

<header class="site-header" data-header>
  <div class="site-header__inner">
    <Logo />
    <nav class="site-header__nav" aria-label="Primary">
      <NavLinks />
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 999;
    width: 100%;
    mix-blend-mode: difference;
    color: var(--color-white);
    background: transparent;
    font-family: var(--font-display);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1em;
    width: 100%;
    /* Live: .container.nav (6em) + .nav-grid (1.5em) = content inset matches grid-item text */
    padding: var(--space-nav-y) calc(var(--space-page-x) + var(--space-grid-item));
  }

  .site-header__nav {
    display: flex;
    align-items: center;
  }

  /* Live ≤991: .navigation — white bar, no mix-blend, black type */
  @media screen and (max-width: 991px) {
    .site-header {
      z-index: 9999;
      mix-blend-mode: normal;
      color: var(--color-black);
      background-color: var(--color-white);
    }

    .site-header__inner {
      /* Live: nav 16px 44px; .nav-grid sides reset to 0 */
      padding: 16px 44px;
    }
  }

  @media screen and (max-width: 767px) {
    .site-header__inner {
      padding: 16px 24px;
    }
  }
</style>
