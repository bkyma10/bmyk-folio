---
import CopyEmailButton from '../ui/CopyEmailButton.astro';
import { navLinks, site } from '../../data/site';

interface Props {
  variant?: 'desktop' | 'mobile';
}

const { variant = 'desktop' } = Astro.props;
const isMobile = variant === 'mobile';
---

<ul class:list={['nav-links', isMobile && 'nav-links--mobile']} role="list">
  {
    navLinks.map((link) => (
      <li>
        <a href={link.href} class="nav-links__item">
          {link.label}
        </a>
      </li>
    ))
  }
  <li>
    {
      isMobile ? (
        <a href={`mailto:${site.email}`} class="nav-links__contact">
          Contact
          <span class="nav-links__arrow" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                fill-rule="evenodd"
                clip-rule="evenodd"
                d="M2.06066 1H23.5607V22.5H20.5607V6.12132L3.12132 23.5607L1 21.4393L18.4393 4H2.06066V1Z"
                fill="currentColor"
              />
            </svg>
          </span>
        </a>
      ) : (
        <CopyEmailButton variant="nav" />
      )
    }
  </li>
</ul>

<style>
  .nav-links {
    display: none;
    align-items: center;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 768px) {
    .nav-links:not(.nav-links--mobile) {
      display: flex;
    }
  }

  .nav-links--mobile {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.5rem;
    width: 100%;
  }

  .nav-links__item {
    display: inline-flex;
    padding: 0.5rem 0.75rem;
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.1;
    transition: opacity var(--duration-fast) ease;
  }

  .nav-links__item:hover {
    opacity: 0.65;
  }

  .nav-links__contact {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid color-mix(in srgb, currentColor 20%, transparent);
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
  }

  .nav-links__arrow {
    display: inline-flex;
  }

  .nav-links--mobile .nav-links__item {
    padding: 0.85rem 0;
    border-bottom: 1px solid color-mix(in srgb, currentColor 20%, transparent);
    font-size: 1.125rem;
    font-weight: 600;
  }
</style>
