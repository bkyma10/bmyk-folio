        </a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #000;
    color: var(--color-white);
  }

  .site-footer__inner {
    padding: 2.9em var(--space-page-x) 2em;
  }

  .site-footer__grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2em;
    padding: var(--space-grid-item);
  }

  .site-footer__heading {
    margin: 0;
    font-size: 2.5em;
    font-weight: 500;
  }

  /* Live .spacer._32 */
  .site-footer__spacer {
    height: 32px;
  }

  .site-footer__social {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .site-footer__social a {
    display: inline-flex;
    transition: opacity var(--duration-fast) ease;
  }

  .site-footer__social a:hover {
    opacity: 0.7;
  }

  /* Live .grid-item-2._50.tablet-100 — full width ≤991 so icons stack under email */
  @media screen and (max-width: 991px) {
    .site-footer__inner {
      padding: 48px var(--space-page-x);
    }

    .site-footer__heading {
      font-size: 32px;
    }

    .site-footer__spacer {
      height: 20px;
    }

    .site-footer__grid {
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
    }

    .site-footer__social {
      justify-content: flex-start;
    }
  }

  @media screen and (max-width: 767px) {
    .site-footer__inner {
      padding: 48px var(--space-page-x);
    }
  }

  @media screen and (max-width: 479px) {
    .site-footer__inner {
      padding: 48px 12px;
    }

    /* Live h1.h2 { font-size: 24px } */
    .site-footer__heading {
      font-size: 24px;
    }

    .site-footer__contact {
      margin-top: 12px;
    }

    .site-footer__social {
      padding: 8px 0;
    }
  }
</style>
