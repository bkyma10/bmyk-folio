---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AllWorks from '../../components/Work/AllWorks.astro';
import { getWorkCategory, site, workCategories } from '../../data/site';

export function getStaticPaths() {
  return workCategories.map((category) => ({
    params: { slug: category.slug },
  }));
}

const { slug } = Astro.params;
const category = slug ? getWorkCategory(slug) : null;

if (!category) {
  return Astro.redirect('/allworks');
}
---

<BaseLayout title={category.pageTitle} description={site.description} dark>
  <AllWorks
    title={category.label}
    items={category.items}
    categories={category.siblingCategories}
    backLink={category.backLink}
    variant="category"
  />
</BaseLayout>
