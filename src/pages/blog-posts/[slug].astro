---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PlaceholderPage from '../../layouts/PlaceholderPage.astro';
import StoryPost from '../../components/Stories/StoryPost.astro';
import { site } from '../../data/site';
import { getStoryPost, storyPosts } from '../../data/stories';

const { slug } = Astro.params;

export function getStaticPaths() {
  return Object.keys(storyPosts).map((storySlug) => ({ params: { slug: storySlug } }));
}

const post = getStoryPost(slug);
---

{
  post ? (
    <BaseLayout title={post.pageTitle} description={site.description}>
      <StoryPost post={post} />
    </BaseLayout>
  ) : (
    <PlaceholderPage
      title="Story"
      description="This story could not be found. Browse more writing from the homepage."
    />
  )
}
