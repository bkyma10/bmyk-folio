---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PlaceholderPage from '../../layouts/PlaceholderPage.astro';
import CaseStudy from '../../components/Work/CaseStudy.astro';
import { allWorks, site } from '../../data/site';
import { getCaseStudy } from '../../data/cases';

const { slug } = Astro.params;

export function getStaticPaths() {
  return allWorks.items.map((item) => ({ params: { slug: item.slug } }));
}

const caseStudy = getCaseStudy(slug);
const fallbackTitle =
  (slug && Object.fromEntries(allWorks.items.map((item) => [item.slug, item.title]))[slug]) ||
  'Case Study';
---

{
  caseStudy ? (
    <BaseLayout title={caseStudy.pageTitle} description={site.description}>
      <CaseStudy caseStudy={caseStudy} />
    </BaseLayout>
  ) : (
    <PlaceholderPage
      title={fallbackTitle}
      description="Full case-study pages are planned for a later phase. Browse more projects on All Work."
    />
  )
}
