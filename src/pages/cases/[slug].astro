---
import PlaceholderPage from '../../layouts/PlaceholderPage.astro';
import { allWorks } from '../../data/site';

const { slug } = Astro.params;

const titles = Object.fromEntries(allWorks.items.map((item) => [item.slug, item.title]));

export function getStaticPaths() {
  return allWorks.items.map((item) => ({ params: { slug: item.slug } }));
}

const title = (slug && titles[slug]) || 'Case Study';
---

<PlaceholderPage
  title={title}
  description="Full case-study pages are planned for a later phase. Browse more projects on All Work."
/>
